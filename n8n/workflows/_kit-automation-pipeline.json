        "responseMode": "onReceived",
        "options": {}
      },
      "id": "c1000001-0001-4000-8000-000000000101",
      "name": "Dashboard Run",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-280, 480],
      "webhookId": "kit-dashboard-main-pipeline"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.body ?? $json;\nreturn [{\n  json: {\n    message: String(raw.message ?? 'Dashboard test run — client requested enterprise pricing quote').trim(),\n    status: String(raw.status ?? 'pending').trim().toLowerCase(),\n    source: String(raw.source ?? 'dashboard').trim()\n  }\n}];"
      },
      "id": "c1000002-0002-4000-8000-000000000102",
      "name": "Format Dashboard Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-40, 480]
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [{ "mode": "everyX", "value": 5, "unit": "minutes" }]
        },
        "documentId": {
          "__rl": true,
          "value": "={{ $env.KIT_TEST_SPREADSHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "Sheet1"
        },
        "event": "rowAdded",
        "options": {
          "dataLocationOnSheet": {
            "values": {
              "rangeDefinition": "specifyRange",
              "headerRow": 1,
              "firstDataRow": 2
            }
          }
        }
      },
      "id": "b1000001-0001-4000-8000-000000000001",
      "name": "New Sheet Row",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [0, 320],
      "credentials": {
        "googleSheetsTriggerOAuth2Api": { "name": "Kit - Google Sheets Trigger" }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\n\nfor (const item of items) {\n  const row = item.json;\n  const message = String(row.message ?? '').trim();\n  const source = String(row.source ?? '').trim();\n  const status = String(row.status ?? '').trim().toLowerCase();\n  const aiSummary = String(row.ai_summary ?? row.aiSummary ?? '').trim();\n\n  if (!message || message.toLowerCase() === 'message') continue;\n  if (status === 'done' || status === 'active') continue;\n\n  const isPending = status === 'pending';\n  const isStuckProcessing = status === 'processing' && !aiSummary;\n  if (!isPending && !isStuckProcessing) continue;\n\n  out.push({ json: { message, source, status, ai_summary: aiSummary } });\n}\n\nreturn out;"
      },
      "id": "b1000002-0002-4000-8000-000000000002",
      "name": "Processable Rows Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 320]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=Write exactly 4 short sentences in plain English for a team update.\nDo not use labels like Subject, Message, Source, or Next Action.\nDo not use markdown, bullets, or special characters.\n\nRequest: {{ $json.message }}\nFrom: {{ $json.source }}"
            }
          ]
        },
        "simplify": true,
        "jsonOutput": false,
        "builtInTools": {
          "googleSearch": false,
          "urlContext": false,
          "codeExecution": false
        },
        "options": { "includeMergedResponse": true }
      },
      "id": "b1000003-0003-4000-8000-000000000003",
      "name": "Gemini Summary",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [520, 320],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 30000,
      "continueOnFail": true,
      "credentials": {
        "googlePalmApi": { "name": "Kit - LLM" }
      }
    },
    {
      "parameters": {
        "jsCode": "function extractText(value) {\n  if (typeof value === 'string' && value.trim()) return value.trim();\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      const found = extractText(item);\n      if (found) return found;\n    }\n    return '';\n  }\n  if (value && typeof value === 'object') {\n    if (typeof value.mergedResponse === 'string' && value.mergedResponse.trim()) return value.mergedResponse.trim();\n    if (typeof value.text === 'string' && value.text.trim()) return value.text.trim();\n    for (const key of ['content', 'parts', 'message', 'candidates']) {\n      const found = extractText(value[key]);\n      if (found) return found;\n    }\n  }\n  return '';\n}\n\nfunction plainEnglish(text) {\n  return String(text)\n    .replace(/^Subject:\\s*.+$/gim, '')\n    .replace(/^Next Action:\\s*.+$/gim, '')\n    .replace(/\\*+/g, '')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n}\n\nconst row = $('Processable Rows Only').item.json;\nconst gemini = $input.first()?.json ?? {};\n\nlet raw = '';\nif (gemini.parts?.[0]?.text) raw = String(gemini.parts[0].text).trim();\nelse if (gemini.content?.parts?.[0]?.text) raw = String(gemini.content.parts[0].text).trim();\nelse if (typeof gemini.mergedResponse === 'string') raw = gemini.mergedResponse.trim();\nelse raw = extractText(gemini);\n\nconst summary = plainEnglish(raw) || `A new request was received about ${row.message} from ${row.source}.`;\nconst processedAt = new Intl.DateTimeFormat('sv-SE', {\n  timeZone: 'Asia/Karachi',\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit',\n  hour: '2-digit',\n  minute: '2-digit',\n  hour12: false,\n}).format(new Date()) + ' (UTC+5)';\n\nconst slackText = [\n  `New request from ${row.source}: ${row.message}`,\n  '',\n  summary,\n  '',\n  `Received at ${processedAt}.`,\n].join('\\n');\n\nconst emailBody = [\n  'Hello,',\n  '',\n  summary,\n  '',\n  `This request came from ${row.source} about \"${row.message}\".`,\n  `Processed at ${processedAt}.`,\n].join('\\n');\n\nreturn [{\n  json: {\n    rowMessage: row.message,\n    rowSource: row.source,\n    summary,\n    processedAt,\n    slackText,\n    emailSubject: `Update: ${row.message}`,\n    emailBody,\n    aiGenerated: Boolean(raw),\n  },\n}];"
      },
      "id": "b1000009-0009-4000-8000-000000000009",
      "name": "Extract Gemini Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 320]
    },
